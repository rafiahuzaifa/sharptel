# Email Configuration for cPanel - sharptel.pk
# Copy this file to .env.local and fill in your actual credentials

EMAIL_HOST=mail.sharptel.pk
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@sharptel.pk
EMAIL_PASS=YOUR_CPANEL_EMAIL_PASSWORD_HERE
EMAIL_FROM=info@sharptel.pk

# Receiving Emails
ADMIN_EMAIL=info@sharptel.pk
HR_EMAIL=careers@sharptel.pk
SALES_EMAIL=sales@sharptel.pk

NODE_ENV=development

# AI Chat Widget (Google Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
